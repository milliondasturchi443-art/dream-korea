generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  phone     String?
  password     String
  emailVerified Boolean?
  verifyCode   String?
  verifyCodeExp DateTime?
  role      Role     @default(STUDENT)
  avatar    String?
  telegramId       String?
  telegramUsername String?
  topikLevel String? @default("TOPIK I")
  xp        Int       @default(0)
  coins     Int       @default(0)
  stars     Int       @default(0)
  streak    Int       @default(0)
  lastStreakAt DateTime?
  // Moderatsiya: ban + IP tarixi (klonlarni kuzatish uchun)
  banned      Boolean   @default(false)
  bannedAt    DateTime?
  bannedReason String?
  lastIp      String?
  lastIpAt    DateTime?
  regIp       String?
  // Sessiyalarni bekor qilish: logout/ban'da +1 — eski tokenlar yaroqsiz bo'ladi (null = 0)
  tokenVersion Int?
  // Telefonning normallashtirilgan kaliti (lib/phone.ts phoneKey) — tez unikal tekshiruv
  phoneKey    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  testAttempts   TestAttempt[]
  admissions     Admission[]
  payments       Payment[]
  notifications  Notification[]
  achievements   Achievement[]
  certificates   Certificate[]
  taughtGroups   Group[]
  groupMembers   GroupMember[]
  attendances    Attendance[]
  homeworks      Homework[]
  homeworkDones  HomeworkDone[]
  darsProgress   DarsProgress[]
  darsExamBests  DarsExamBest[]
  writingAttempts WritingAttempt[]
  topikWritingAttempts TopikWritingAttempt[]
  receptions      Reception[]

  @@index([phoneKey])
}

// Reception: front-desk student intake (name, phone, schedule, teacher)
model Reception {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  phone       String
  days        String   // e.g. "Dushanba,Chorshanba,Juma"
  time        String   // e.g. "15:00"
  address     String?  // yashash manzil
  parentName  String?  // ota-ona F.I.Sh.
  parentPhone String?  // ota-ona telefon raqami
  startDate   String?  // kurs boshlash sanasi, "YYYY-MM-DD"
  purpose     String?  // til o'rganish maqsadi, comma-joined: "TOPIK,Koreada o'qish,…"
  plan        String?  // kelajakdagi reja: "Til kursi" | "Kolleg" | "Bakalavr" | "Magistr"
  teacherId   String?  @db.ObjectId
  teacher     User?    @relation(fields: [teacherId], references: [id])
  groupId     String?  @db.ObjectId
  group       Group?   @relation(fields: [groupId], references: [id])
  note        String?
  status      String   @default("new") // new | contacted | enrolled
  createdAt   DateTime @default(now())
}

model Course {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String?
  level       String
  description String?
  teacherId   String?  @db.ObjectId
  teacherName String?
  price       Int      @default(0)
  lessons     Lesson[]
  enrollments Enrollment[]
  createdAt   DateTime @default(now())
}

model Lesson {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String   @db.ObjectId
  course    Course   @relation(fields: [courseId], references: [id])
  order     Int
  title     String
  duration  String?
  videoUrl  String?
  content   String?
  progress  LessonProgress[]
  createdAt DateTime @default(now())
}

model Enrollment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  courseId  String   @db.ObjectId
  course    Course   @relation(fields: [courseId], references: [id])
  progress  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id])
  lessonId  String  @db.ObjectId
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
  completed Boolean @default(false)

  @@unique([userId, lessonId])
}

model Test {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  level     String
  type      String
  questions Question[]
  attempts  TestAttempt[]
  createdAt DateTime @default(now())
}

model Question {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  testId      String   @db.ObjectId
  test        Test     @relation(fields: [testId], references: [id])
  text        String
  options     Json
  correct     String
  explanation String?
  order       Int
}

model TestAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  testId    String   @db.ObjectId
  test      Test     @relation(fields: [testId], references: [id])
  score     Int
  total     Int
  answers   Json
  createdAt DateTime @default(now())
}

model Vocabulary {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ko        String
  tr        String
  uz        String
  level     String
  cat       String   @default("greeting")
  createdAt DateTime @default(now())
}

model Grammar {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  desc      String
  level     String
  content   String?
}

model Book {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String   @default("")
  category    String   @default("Darslik")
  level       String   @default("Boshlang'ich")
  pages       Int      @default(0)
  sizeMb      Float    @default(0)
  color       String   @default("from-blue-700 to-indigo-800")
  code        String   @default("")
  description String   @default("")
  cover       String?
  file        String?
  fileId      String?
  createdAt   DateTime @default(now())
}

model Video {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  category  String
  duration  String
  videoUrl  String?
  createdAt DateTime @default(now())
}

model Material {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  kind      String
  url       String?
  createdAt DateTime @default(now())
}

model University {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  city        String
  programs    String[]
  topik       String
  tuition     String
  description String?
  ranking     Int?
  faculties   String[]
  deadline    String?
  language    String?
  dorm        String?
  website     String?
  image       String?
}

model Group {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  teacherId String?  @db.ObjectId
  teacher   User?    @relation(fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  members   GroupMember[]
  attendances Attendance[]
  homeworks Homework[]
  receptions Reception[]
}

model GroupMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId  String   @db.ObjectId
  group    Group    @relation(fields: [groupId], references: [id])
  userId   String   @db.ObjectId
  user     User     @relation(fields: [userId], references: [id])
  joinedAt DateTime @default(now())
  @@unique([groupId, userId])
}

model Attendance {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId   String   @db.ObjectId
  group     Group    @relation(fields: [groupId], references: [id])
  studentId String   @db.ObjectId
  student   User     @relation(fields: [studentId], references: [id])
  date      String
  status    String
  note      String?
  createdAt DateTime @default(now())
  @@unique([groupId, studentId, date])
}

model Homework {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  groupId     String   @db.ObjectId
  group       Group    @relation(fields: [groupId], references: [id])
  teacherId   String   @db.ObjectId
  teacher     User     @relation(fields: [teacherId], references: [id])
  title       String
  description String?
  dueDate     String?
  createdAt   DateTime @default(now())
  dones       HomeworkDone[]
}

// O'quvchining uy vazifasini bajarilganlik belgisi (Bajar gan / Bajar magan)
model HomeworkDone {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  homeworkId String   @db.ObjectId
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String   @db.ObjectId
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([homeworkId, studentId])
}

model Admission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  phone     String
  email     String
  birth     String?
  edu       String?
  topik     String?
  uni       String?
  comment   String?
  createdAt DateTime @default(now())
}

model Payment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  userId    String        @db.ObjectId
  user      User          @relation(fields: [userId], references: [id])
  amount    Int
  method    String
  month     String?
  note      String?
  status    PaymentStatus @default(PENDING)
  // Audit: kim yaratdi / kim "to'landi" deb belgiladi
  createdById String?     @db.ObjectId
  paidById    String?     @db.ObjectId
  paidAt      DateTime?
  createdAt DateTime      @default(now())
}

model News {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  body      String
  image     String? // data URL (base64) — admin yuklagan rasm
  pinned    Boolean  @default(false) // e'lon: bosh sahifada yuqorida katta ko'rinadi
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Achievement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  title     String
  createdAt DateTime @default(now())
}

model Certificate {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  courseId  String   @db.ObjectId
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  meta      Json?
  createdAt DateTime @default(now())
}

// ── Darslar / Units ──────────────────────────────────────────────────────────
model TopikWritingAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId  String
  text      String
  score     Int?
  feedback  String?
  createdAt DateTime @default(now())

  @@index([userId, promptId])
}

model DarsUnit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  order       Int      @unique
  title       String
  topic       String
  level       String   @default("A1")
  cover       String?
  description String?
  vocab       DarsVocab[]
  videos      DarsVideo[]
  grammars    DarsGrammar[]
  listenings  DarsListening[]
  writings    DarsWriting[]
  progress    DarsProgress[]
  createdAt   DateTime @default(now())
}

model DarsVocab {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  unitId    String   @db.ObjectId
  unit      DarsUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  ko        String
  uz        String
  tr        String?
  exampleKo String?
  exampleUz String?
  order     Int      @default(0)
}

model DarsVideo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  unitId    String   @db.ObjectId
  unit      DarsUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  videoUrl  String
  duration  String?
  order     Int      @default(0)
}

model DarsGrammar {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  unitId    String   @db.ObjectId
  unit      DarsUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  pattern   String?
  explain   String
  examples  Json     // [{ko, uz}]
  exercises Json     // [{q, options, correct, hint}]
  order     Int      @default(0)
}

model DarsListening {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  unitId      String   @db.ObjectId
  unit        DarsUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title       String
  audioUrl    String?
  audioText   String?
  transcript  String?
  imageUrl    String?
  questions   Json     // [{text, options:[{key,text}], correct, explanation}]
  order       Int      @default(0)
}

model DarsWriting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  unitId      String   @db.ObjectId
  unit        DarsUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title       String
  prompt      String
  criteria    String?
  sampleAnswer String?
  order       Int      @default(0)
  attempts    WritingAttempt[]
}

model WritingAttempt {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  writingId  String      @db.ObjectId
  writing    DarsWriting @relation(fields: [writingId], references: [id], onDelete: Cascade)
  userId     String      @db.ObjectId
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  score      Int?
  feedback   String?
  createdAt  DateTime    @default(now())
}

model DarsProgress {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId     String   @db.ObjectId
  unit       DarsUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vocabDone     Boolean @default(false)
  videoDone     Boolean @default(false)
  homeworkDone  Boolean @default(false)
  grammarDone   Boolean @default(false)
  listeningDone Boolean @default(false)
  writingDone   Boolean @default(false)
  stars      Int      @default(0) // 0-3
  xpAwarded  Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  @@unique([userId, unitId])
}

model DarsExamBest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  from      Int
  to        Int
  score     Int
  total     Int
  attempts  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, from])
}

// TOPIK sahifasidagi kirish kartochkalari (O'qish / Tinglash / Yozish) — admin tahrirlaydi.
// Bo'sh bo'lsa API standart kartochkalarni qaytaradi (sayt hech qachon buzilmaydi).
model TopikCard {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  desc      String   @default("")
  href      String
  icon      String   @default("BookOpen") // lib/topik-cards.ts ICONS kalitlari
  color     String   @default("blue-600") // lib/topik-cards.ts COLOR_KEYS
  order     Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}
